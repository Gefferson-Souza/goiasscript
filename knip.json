{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    "packages/core",
    "apps/*"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts"
      ],
      "project": [
        "*.{ts,mts,mjs}",
        "scripts/**"
      ],
      "ignoreDependencies": [
        "lint-staged",
        "@commitlint/cli"
      ]
    },
    "packages/language": {
      "entry": [
        "generators/run.ts",
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "generators/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/compiler": {
      "entry": [
        "tests/**/*.test.ts",
        "tests/support/deterministic-preload.mjs",
        "tests/support/list-expected-fail.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "tests/support/*.mjs",
        "bench/**/*.ts",
        "*.mjs"
      ]
    },
    "packages/optimizer": {
      "entry": [
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/cli": {
      "entry": [
        "src/entry/*.ts",
        "tests/**/*.test.ts",
        "tests/e2e/**/*.e2e.ts",
        "tests/support/source-main.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "tools/rules-scan": {
      "entry": [
        "tests/**/*.test.mjs"
      ],
      "project": [
        "src/**/*.mjs",
        "tests/**/*.mjs"
      ]
    },
    "tools/config-tests": {
      "entry": [
        "tests/**/*.test.mjs"
      ],
      "project": [
        "tests/**/*.mjs"
      ]
    }
  },
  "ignore": [
    "spikes/**"
  ]
}
