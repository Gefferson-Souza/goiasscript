  "tokenizer": {
    "root": [
      [
        "[\\p{L}_][\\p{L}\\p{N}_]*",
        {
          "cases": {
            "@keywords": "keyword",
            "@library": "type.identifier",
            "@default": "identifier"
          }
        }
      ],
      [
        "\\d+(\\.\\d+)?([eE][+-]?\\d+)?",
        "number"
      ],
      [
        "\"",
        {
          "token": "string",
          "next": "@dq"
        }
      ],
      [
        "'",
        {
          "token": "string",
          "next": "@sq"
        }
      ],
      [
        "//.*$",
        "comment"
      ],
      [
        "/\\*",
        {
          "token": "comment",
          "next": "@comment"
        }
      ]
    ],
    "dq": [
      [
        "[^\\\\\"]+",
        "string"
      ],
      [
        "\\\\.",
        "string.escape"
      ],
      [
        "\"",
        {
          "token": "string",
          "next": "@pop"
        }
      ]
    ],
    "sq": [
      [
        "[^\\\\']+",
        "string"
      ],
      [
        "\\\\.",
        "string.escape"
      ],
      [
        "'",
        {
          "token": "string",
          "next": "@pop"
        }
      ]
    ],
    "comment": [
      [
        "[^/*]+",
        "comment"
      ],
      [
        "\\*/",
        {
          "token": "comment",
          "next": "@pop"
        }
      ],
      [
        "[/*]",
        "comment"
      ]
    ]
  }
