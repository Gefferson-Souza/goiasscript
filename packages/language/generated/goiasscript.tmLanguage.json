{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GoiásScript",
  "scopeName": "source.goiasscript",
  "patterns": [
    {
      "name": "comment.line.double-slash.goiasscript",
      "match": "//.*$"
    },
    {
      "name": "comment.block.goiasscript",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.goiasscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.goiasscript",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.goiasscript",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.goiasscript",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.goiasscript",
      "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
    },
    {
      "name": "keyword.operator.assignment.goiasscript",
      "match": "(?<![\\p{L}\\p{N}_])(é)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "storage.type.class.goiasscript",
      "match": "(?<![\\p{L}\\p{N}_])(aprepara_trem|arruma_trem|inherda_de|e_tipo_de|é_tipo_de|num_muda|a_raiz|faz_um|oce|ocê)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.control.goiasscript",
      "match": "(?<![\\p{L}\\p{N}_])(enquanto_tiver|para_com_isso|se_oce_quiser|se_ocê_quiser|continua_ai|continua_aí|se_num_for|vai_indo|se_nao|se_não|de|em)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "storage.type.goiasscript",
      "match": "(?<![\\p{L}\\p{N}_])(trem|uai)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.control.trycatch.goiasscript",
      "match": "(?<![\\p{L}\\p{N}_])(se_der_ruim|tenta_ai|tenta_aí|por_fim|vixe)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "storage.type.function.goiasscript",
      "match": "(?<![\\p{L}\\p{N}_])(vai_na_frente_faz_trem|espera_um_cadim|vai_na_frente|faz_favor|faz_trem)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.language.goiasscript",
      "match": "(?<![\\p{L}\\p{N}_])(de_jeito_nenhum|indefinido|certeza|nada)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.operator.word.goiasscript",
      "match": "(?<![\\p{L}\\p{N}_])(pelo_menos|diferente|e_igualim|maior_que|menor_que|no_maximo|no_máximo|é_igualim|dividido|ou_entao|ou_então|e_mais|sobrou|menos|num_e|num_é|vezes|mais)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "support.function.member.goiasscript",
      "match": "(?<=\\.)(?<![\\p{L}\\p{N}_])(arredondar_pra_baixo|arredondar_pra_cima|de_tras_pra_frente|de_trás_pra_frente|ranca_os_espaco|ranca_os_espaço|bota_no_comeco|bota_no_começo|quando_der_bao|quando_der_bão|ranca_a_cabeca|ranca_a_cabeça|bota_no_final|raiz_quadrada|ranca_do_meio|ranca_o_sinal|ranca_o_rabo|cochichando|se_der_ruim|tem_no_meio|termina_com|tudim_junto|arredondar|comeca_com|começa_com|sorteia_um|vira_coisa|vira_texto|com_casas|elevado_a|onde_ta_o|onde_tá_o|tem_algum|agorinha|amontoar|entradas|gritando|mensagem|pra_cada|dividir|filtrar|mistura|o_tanto|onde_ta|onde_tá|segundo|valores|ajunta|arruma|chaves|emenda|mapear|minuto|repete|trocar|maior|menor|todin|cata|hora|naco|ano|dia|mes|mês|tem|PI|E)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "support.function.goiasscript",
      "match": "(?<![\\p{L}\\p{N}_])(daqui_um_cadim|vira_numero|vira_número|vira_texto|larga_mao|larga_mão|toda_hora|Promessa|e_numero|pergunta|é_número|cochila|reclama|Coisa|Conta|avisa|prosa|Data|Erro)(?![\\p{L}\\p{N}_])"
    }
  ]
}
