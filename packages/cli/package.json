    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gefferson-Souza/goiasscript.git"
  },
  "devDependencies": {
    "@goiasscript/compiler": "workspace:*",
    "@goiasscript/language": "workspace:*",
    "@goiasscript/optimizer": "workspace:*",
    "esbuild": "0.28.2"
  }
