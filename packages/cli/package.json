{
  "name": "goiasscript",
  "version": "3.0.0",
  "description": "GoiásScript: linguagem de programação em goianês que vira JavaScript",
  "type": "module",
  "bin": {
    "goiasscript": "./dist/goiasscript.mjs",
    "goias": "./dist/goias.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gefferson-Souza/goiasscript.git"
  },
  "devDependencies": {
    "@goiasscript/compiler": "workspace:*",
    "@goiasscript/language": "workspace:*",
    "@goiasscript/optimizer": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "node ../../scripts/build-cli.ts",
    "prepack": "node ../../scripts/prepack-cli.ts",
    "postpack": "node ../../scripts/prepack-cli.ts clean",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "mutate": "GS_TIMING_BUDGETS=skip stryker run"
  }
}
