  "bin": {
    "goiasscript": "./dist/goiasscript.mjs",
    "goias": "./dist/goias.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
