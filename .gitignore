# 🇧🇷 .gitignore GoiásScript - Produção
# Arquivos que não devem subir para o repositório

# === DEPENDÊNCIAS ===
node_modules/
bun.lockb
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === BUILDS E CACHE ===
dist/
build/
.cache/
.eslintcache
.parcel-cache/
*.tsbuildinfo
.next/
.nuxt/
.output/
*.tgz

# === ARQUIVOS TEMPORÁRIOS ===
.tmp/
temp/
*.tmp
*.temp.*
*.log
*.pid
*.pid.lock
*.seed

# === ARQUIVOS DE DESENVOLVIMENTO ===
debug-report.json
*.js.map

# === CLAUDE CODE LOCAL CONFIG ===
.claude/

# === AMBIENTE ===
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
apps/*/.env.local
apps/*/.dev.vars

# === APPS (Next.js + Cloudflare) ===
apps/*/.next/
apps/*/.next-configured/
apps/*/.vercel/
apps/*/.wrangler/
apps/playground/public/examples/
apps/playground/public/vs/

# === PLAYWRIGHT E2E ===
apps/playground-e2e/test-results/
apps/playground-e2e/playwright-report/
apps/playground-e2e/.last-run.json
apps/playground-e2e/blob-report/

# === SISTEMA OPERACIONAL ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# === EDITORES ===
.vscode/*
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# === PROJETOS DE TESTE (não devem subir) ===
/meu-projeto/
/minha-loja/
docs/plano/
/teste-*/
/testando-*/
projeto-teste/
meu-package-*/
teste-rapido.gs
teste-global.gs
projeto-teste-manual/
exemplo_*.gs
teste_*.gs

# === COVERAGE E TESTES ===
coverage/
.nyc_output/
*.lcov
test-results/
screenshots/
.coverage
*.cover
.hypothesis/
.pytest_cache/

# === TEMPLATES NODE_MODULES ===
templates/*/node_modules/

# === ANTIGOS PACKAGE MANAGERS ===
gspack.json

# === CERTIFICADOS E CHAVES ===
*.pem
*.key
*.cert

# === BANCO DE DADOS LOCAL ===
*.db
*.sqlite
*.sqlite3

# === MANTER ESSENCIAL ===
# Manter arquivos essenciais:
!src/
!examples/**/*.gs
!templates/
!balaios/
research_notes/
reports/

# === MUTAÇÃO ===
.stryker-tmp/
packages/compiler/reports/

# Gerados pelo build do playground
apps/playground/public/sandbox/
apps/playground/content/o-que-mudou.md

# === EXTENSAO VS CODE ===
packages/vscode/pack/

# === TESTES DA EXTENSÃO DENTRO DO VS CODE ===
packages/vscode/.integration/
packages/vscode/.vscode-test/

# === PACOTES DA EXTENSAO ===
*.vsix

# === EVIDENCIA CONGELADA ===
!docs/auditoria/**/*.log
!docs/auditoria/**/package-lock.json
!docs/auditoria/**/test-results/
