{
  "name": "goiasscript-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "🇧🇷 Monorepo do GoiásScript — linguagem de programação goiana, playground web e ENGOIANADOR API",
  "scripts": {
    "legacy:test": "pnpm --filter goiasscript test",
    "legacy:test:coverage": "pnpm --filter goiasscript test:coverage",
    "legacy:lint": "ESLINT_USE_FLAT_CONFIG=false pnpm --filter goiasscript lint",
    "legacy:lint:fix": "ESLINT_USE_FLAT_CONFIG=false pnpm --filter goiasscript lint:fix",
    "legacy:format": "pnpm --filter goiasscript format",
    "legacy:format:check": "pnpm --filter goiasscript format:check",
    "playground:dev": "pnpm --filter playground dev",
    "playground:build": "pnpm --filter playground build",
    "playground:start": "pnpm --filter playground start",
    "engoianador:dev": "pnpm --filter engoianador-api dev",
    "engoianador:deploy": "pnpm --filter engoianador-api deploy",
    "engoianador:typecheck": "pnpm --filter engoianador-api typecheck",
    "engoianador:test": "pnpm --filter engoianador-api test",
    "e2e": "pnpm --filter playground-e2e test:e2e",
    "prepare": "husky",
    "typecheck": "tsc -p tsconfig.json",
    "rules-scan": "node tools/rules-scan/src/cli.mjs check",
    "test": "vitest run --coverage",
    "agent-docs": "node scripts/check-agent-docs.ts",
    "verify": "tsc -p tsconfig.json && eslint . --max-warnings 0 && node tools/rules-scan/src/cli.mjs check && vitest run --coverage && depcruise packages tools --config .dependency-cruiser.cjs && knip && node scripts/check-agent-docs.ts",
    "lint": "eslint . --max-warnings 0",
    "depcruise": "depcruise packages tools --config .dependency-cruiser.cjs",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-functional": "10.0.1",
    "husky": "9.1.7",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=10.31.0"
  },
  "packageManager": "pnpm@10.31.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gefferson-Souza/goiasscript.git"
  },
  "license": "MIT"
}
