{
  "name": "goiasscript-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "🇧🇷 Monorepo do GoiásScript — linguagem de programação goiana, playground web e ENGOIANADOR API",
  "scripts": {
    "playground:dev": "pnpm --filter playground dev",
    "playground:build": "pnpm --filter playground build",
    "playground:start": "pnpm --filter playground start",
    "engoianador:dev": "pnpm --filter engoianador-api dev",
    "engoianador:deploy": "pnpm --filter engoianador-api run deploy",
    "engoianador:typecheck": "pnpm --filter engoianador-api typecheck",
    "engoianador:test": "pnpm --filter engoianador-api test",
    "build:cli": "node scripts/build-cli.ts",
    "pack:cli": "node scripts/pack-cli.ts",
    "build:vscode": "node scripts/build-vscode.ts",
    "pack:vscode": "node scripts/pack-vscode.ts",
    "e2e": "pnpm --filter playground-e2e test:e2e",
    "prepare": "husky",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/playground/tsconfig.json && tsc -p apps/engoianador-api/tsconfig.json",
    "generate:check": "node packages/language/generators/run.ts --check && node scripts/build-vscode.ts --check-assets && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/playground/scripts/build-lesson-index.ts --check",
    "rules-scan": "node tools/rules-scan/src/cli.mjs check",
    "test": "vitest run --coverage",
    "bless": "node scripts/bless.ts",
    "agent-docs": "node scripts/check-agent-docs.ts",
    "docs:blocks": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs-blocks.ts",
    "docs:commands": "node scripts/check-docs-commands.ts",
    "english-ui": "node scripts/check-english-ui.ts",
    "traceability": "node scripts/check-traceability.ts",
    "compiler-dependencies": "node scripts/check-compiler-dependencies.ts",
    "verify": "tsc -p tsconfig.json && tsc -p apps/playground/tsconfig.json && tsc -p apps/engoianador-api/tsconfig.json && tsc -p apps/playground-e2e/tsconfig.json && eslint . --max-warnings 0 && node tools/rules-scan/src/cli.mjs check && node packages/language/generators/run.ts --check && node scripts/build-vscode.ts --check-assets && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/playground/scripts/build-lesson-index.ts --check && vitest run --coverage && vitest run --project compiler && depcruise packages tools --config .dependency-cruiser.cjs && knip && node scripts/check-agent-docs.ts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs-blocks.ts && node scripts/check-docs-commands.ts && node scripts/check-english-ui.ts && node scripts/check-compiler-dependencies.ts && node scripts/check-traceability.ts",
    "lint": "eslint . --max-warnings 0",
    "depcruise": "depcruise packages tools --config .dependency-cruiser.cjs",
    "knip": "knip",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "15.5.28",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.1.6",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=10.31.0"
  },
  "packageManager": "pnpm@10.31.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gefferson-Souza/goiasscript.git"
  },
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.16",
      "serialize-javascript": "^7.0.5",
      "diff@7.0.0": "^8.0.3",
      "ws": "^8.21.0",
      "esbuild@0.17.19": "^0.28.2",
      "next>postcss": "^8.5.23",
      "deepmerge-ts": "^8.0.0",
      "@fastify/busboy": "^3.2.2",
      "undici@5.29.0": "^6.28.1",
      "sharp@0.33.5": "^0.35.5",
      "semver@7.0.0": "^7.5.2",
      "postcss-selector-parser@6.1.5": "^7.1.6",
      "qs@<6.16.0": "^6.16.1"
    },
    "patchedDependencies": {
      "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator__vitest-runner@10.0.0.patch"
    }
  }
}
