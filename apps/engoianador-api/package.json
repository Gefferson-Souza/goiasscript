{
  "name": "engoianador-api",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "🪄 Cloudflare Worker que engoiana texto via LLM (Groq + fallback Workers AI)",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "predeploy": "node scripts/check-worker-config.ts && node scripts/verify-model.ts --require",
    "deploy": "wrangler deploy --env=\"\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  }
}
